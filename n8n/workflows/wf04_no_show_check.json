            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Geändert?": {
      "main": [
        [
          {
            "node": "An Mail Dispatcher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
